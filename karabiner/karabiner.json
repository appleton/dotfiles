                    "key_code": "left_arrow"
                  }
                ],
                "conditions": [
                  {
                    "type": "device_if",
                    "identifiers": [
                      {
                        "is_built_in_keyboard": true
                      }
                    ]
                  },
                  {
                    "type": "variable_if",
                    "name": "builtin_f_nav",
                    "value": 1
                  }
                ]
              },
              {
