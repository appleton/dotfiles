          {
            "description": "j then k -> Escape (Neovim 1000 ms timeout; outside terminals and VS Code)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "k"
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "jk_escape_pending",
                      "value": false
                    }
                  },
                  {
                    "key_code": "escape",
                    "repeat": false
                  }
                ],
                "conditions": [
                  {
                    "type": "frontmost_application_unless",
                    "bundle_identifiers": [
                      "^com\\.mitchellh\\.ghostty$",
                      "^com\\.googlecode\\.iterm2$",
                      "^com\\.apple\\.Terminal$",
                      "^com\\.microsoft\\.VSCode$",
                      "^com\\.microsoft\\.VSCodeInsiders$"
                    ]
                  },
                  {
                    "type": "variable_if",
                    "name": "jk_escape_pending",
                    "value": true
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "j"
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "jk_escape_pending",
                      "value": true
                    }
                  }
                ],
                "to_delayed_action": {
                  "to_if_invoked": [
                    {
                      "key_code": "j",
                      "conditions": [
                        {
                          "type": "variable_if",
                          "name": "jk_escape_pending",
                          "value": true
                        }
                      ]
                    },
                    {
                      "set_variable": {
                        "name": "jk_escape_pending",
                        "value": false
                      }
                    }
                  ],
                  "to_if_canceled": [
                    {
                      "key_code": "j",
                      "conditions": [
                        {
                          "type": "variable_if",
                          "name": "jk_escape_pending",
                          "value": true
                        }
                      ]
                    },
                    {
                      "set_variable": {
                        "name": "jk_escape_pending",
                        "value": false
                      }
                    }
                  ]
                },
                "conditions": [
                  {
                    "type": "frontmost_application_unless",
                    "bundle_identifiers": [
                      "^com\\.mitchellh\\.ghostty$",
                      "^com\\.googlecode\\.iterm2$",
                      "^com\\.apple\\.Terminal$",
                      "^com\\.microsoft\\.VSCode$",
                      "^com\\.microsoft\\.VSCodeInsiders$"
                    ]
                  }
                ],
                "parameters": {
                  "basic.to_delayed_action_delay_milliseconds": 1000,
                  "basic.to_if_held_down_threshold_milliseconds": 1000
                },
                "to_if_held_down": [
                  {
                    "set_variable": {
                      "name": "jk_escape_pending",
                      "value": false
                    }
                  },
                  {
                    "key_code": "j",
                    "conditions": [
                      {
                        "type": "variable_if",
